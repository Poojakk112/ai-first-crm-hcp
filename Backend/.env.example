# Groq API key - get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model used by the LangGraph agent (assignment-mandated model)
GROQ_MODEL=gemma2-9b-it

# Database connection string
# Postgres example: postgresql+psycopg2://user:password@localhost:5432/crm_db
# MySQL example:    mysql+pymysql://user:password@localhost:3306/crm_db
# SQLite (local/dev fallback, no server needed):
DATABASE_URL=sqlite:///crm.db
